generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  OK
  BROKEN
  PENDING
  NEEDS_IMPROVEMENT
}

model Project {
  id           String      @id @default(cuid())
  name         String
  githubRepoUrl String
  status       ProjectStatus
  category     String?
  tags         String[]
  deployedUrl  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
